{
  "enabledPlugins": {
    "claude-api@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": false
  },
  "disabledMcpjsonServers": ["context7"],
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-memory"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/global-skills/everything/strategic-compact/suggest-compact.js"
          }
        ],
        "description": "战略压缩建议：Edit/Write 超过阈值时提醒 compact"
      },
      {
        "matcher": "tool == \"Write\" && path.match(/\\.py$/)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json; p='.claude/dev-flow.json'; d=json.load(open(p)); d['stats']['filesModified']=d['stats'].get('filesModified',0)+1; json.dump(d,open(p,'w'),indent=2); c=d['stats']['filesModified']; print(f'📊 文件修改 {c} 次' + (' — 建议运行 /dev-flow check' if c>=5 else ''))\""
          }
        ],
        "description": "文件修改计数：.py 文件修改 ≥5 次时建议验证"
      },
      {
        "matcher": "tool == \"Write\" && path.match(/ui\\//)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔔 UI 文件已修改 — 建议运行 python3 gui_integrity_check.py'"
          }
        ],
        "description": "UI 文件修改提醒：ui/ 目录修改时建议 GUI 检查"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Bash\" && command.match(/pytest/)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,subprocess; p='.claude/dev-flow.json'; d=json.load(open(p)); d['stats']['testsRun']=d['stats'].get('testsRun',0)+1; json.dump(d,open(p,'w'),indent=2)\""
          }
        ],
        "description": "测试运行计数：pytest 运行后更新统计"
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-distill.sh"
          }
        ],
        "description": "压缩前自动 distill: 保存 git log + 文件变更到 CURRENT_STATE.md"
      }
    ]
  }
}
