{
  "enabledPlugins": {
    "claude-api@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": false
  },
  "disabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/global-skills/everything/strategic-compact/suggest-compact.js"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py dev-flow"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py func-catalog"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py ui-reminder"
          }
        ],
        "description": "文件写入前: 压缩建议 + dev-flow 计数 + FUNC_CATALOG 提醒 + UI 门禁提醒"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py interface-audit-staged"
          }
        ],
        "description": "git commit 前审计暂存区接口变更 (必须是 PreToolUse: 挂 PostToolUse 时 commit 已完成, --staged 看不到内容)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py interface-audit"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py gui-audit"
          }
        ],
        "description": "写入 .py 后接口审计; 写入 ui/ 后 GUI 审计"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py post-commit"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/hook_dispatch.py pytest-count"
          }
        ],
        "description": "git commit 后清缓存+重建 FUNC_CATALOG+针对性验证; pytest 后更新统计"
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-distill.sh"
          }
        ],
        "description": "自动压缩前保存 git log + 文件变更到 CURRENT_STATE.md"
      }
    ]
  },
  "env": {
    "QT_QPA_PLATFORM": "offscreen"
  }
}
