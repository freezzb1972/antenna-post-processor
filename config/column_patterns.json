{
  "_comment": "模板列头识别模式配置。JSON 模式优先于 Python 内置正则，先匹配者胜。用户可通过「工具→模板识别...」编辑。",
  "version": "1.0",
  "patterns": [
    {"col_type": "frequency",          "label": "频率",             "keywords": ["freq", "frequency"]},
    {"col_type": "directivity",        "label": "方向性",           "keywords": ["directivity", "dir"]},
    {"col_type": "total_efficiency_db","label": "总效率(dB)",       "keywords": ["total", "efficiency", "db"]},
    {"col_type": "total_efficiency_pct","label": "总效率(%)",       "keywords": ["total", "efficiency"], "negate": ["db"]},
    {"col_type": "efficiency_db",      "label": "效率(dB)",        "keywords": ["efficiency", "db"]},
    {"col_type": "efficiency_pct",     "label": "效率(%)",         "keywords": ["efficiency"], "negate": ["db"]},
    {"col_type": "gain",               "label": "峰值增益",         "keywords": ["gain"], "negate": ["average", "avg", "theta"]},
    {"col_type": "trp",                "label": "TRP",            "keywords": ["trp"], "negate": ["nhprp"]},
    {"col_type": "nhprp_45",           "label": "NHPRP ±45°",     "keywords": ["nhprp", "45"]},
    {"col_type": "nhprp_30",           "label": "NHPRP ±30°",     "keywords": ["nhprp", "30"]},
    {"col_type": "nhprp_225",          "label": "NHPRP ±22.5°",   "keywords": ["nhprp", "22.5"]},
    {"col_type": "peak_eirp",          "label": "Peak EIRP",      "keywords": ["peak", "eirp"]},
    {"col_type": "ar_single",          "label": "AR 单角度",       "keywords": ["ar", "theta"], "negate": ["~"]},
    {"col_type": "ar_range",           "label": "AR 范围",         "keywords": ["ar", "~"]},
    {"col_type": "uh_prp",             "label": "上半球 PRP",      "keywords": ["upper", "hem", "prp"]},
    {"col_type": "lh_prp",             "label": "下半球 PRP",      "keywords": ["lower", "hem", "prp"]},
    {"col_type": "boresight_phi",      "label": "Boresight Phi",  "keywords": ["boresight", "phi"]},
    {"col_type": "boresight_theta",    "label": "Boresight Theta", "keywords": ["boresight", "theta"]},
    {"col_type": "max_power",          "label": "最大功率",         "keywords": ["max", "power"], "negate": ["average", "avg"]},
    {"col_type": "min_power",          "label": "最小功率",         "keywords": ["min", "power"], "negate": ["average", "avg"]},
    {"col_type": "avg_gain",           "label": "平均增益",         "keywords": ["average", "gain"]},
    {"col_type": "avg_power",          "label": "平均功率",         "keywords": ["average", "power"]},
    {"col_type": "xpi_boresight",      "label": "XPI Boresight",  "keywords": ["xpi", "boresight"]},
    {"col_type": "xpi_mean",           "label": "XPI Mean",       "keywords": ["xpi", "mean"]},
    {"col_type": "xpi_min",            "label": "XPI Min",        "keywords": ["xpi", "min"], "negate": ["mean"]},
    {"col_type": "mismatch_loss_db",   "label": "Mismatch Loss",  "keywords": ["mismatch", "loss"]},
    {"col_type": "pc_theta_mm",        "label": "Phase Center θ", "keywords": ["pc", "theta"]},
    {"col_type": "pc_phi_mm",          "label": "Phase Center φ", "keywords": ["pc", "phi"]}
  ]
}
